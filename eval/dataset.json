    { "id": "m-101", "sender": "mia", "text": "周六上午有人想一起去 Costco 吗？我没有车，想买一大袋米和日用品。", "sentAt": "2026-09-16T10:20:00+08:00", "label": { "speech_act": ["request"], "needs_counterpart": true, "reusable": false } },
    { "id": "m-102", "sender": "leo", "text": "I can drive to Costco Saturday around 10:30. Two seats available; pickup near North Gate.", "sentAt": "2026-09-16T11:05:00+08:00", "label": { "speech_act": ["offer"], "needs_counterpart": true, "reusable": false } },
    { "id": "m-103", "sender": "mia", "text": "太好了！我在北门，10:30 可以。", "sentAt": "2026-09-16T11:12:00+08:00", "replyToId": "m-102", "label": { "speech_act": ["status_update", "acknowledgement"], "updates": { "target_message_id": "m-101", "new_state": "fulfilled" } } },
    { "id": "m-104", "sender": "ravi", "text": "Anyone heading to the airport Friday evening? I have one suitcase and can share gas.", "sentAt": "2026-09-15T16:40:00+08:00", "label": { "speech_act": ["request"], "needs_counterpart": true, "reusable": false } },
