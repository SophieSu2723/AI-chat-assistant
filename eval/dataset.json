    { "id": "m-107", "sender": "ravi", "text": "周日有人去 Trader Joe’s 吗？想搭车，时间还没定。", "sentAt": "2026-09-17T14:05:00+08:00", "label": { "speech_act": ["request"], "needs_counterpart": true, "reusable": false } },
    { "id": "m-108", "sender": "leo", "text": "My Saturday Costco car is full now.", "sentAt": "2026-09-17T16:10:00+08:00", "replyToId": "m-102", "label": { "speech_act": ["status_update"], "updates": { "target_message_id": "m-102", "new_state": "full" } } },
    { "id": "m-201", "sender": "zoe", "text": "How can I get to Costco without a car?", "sentAt": "2026-09-02T09:10:00+08:00", "label": { "speech_act": ["question"], "needs_counterpart": false } },
    { "id": "m-202", "sender": "mia", "text": "From campus, take bus 6 to Central Station, then the 118 toward Costco. It takes about 45–55 minutes; the transfer is indoors. Check the weekend timetable because service is every 30 minutes.", "sentAt": "2026-09-02T09:25:00+08:00", "replyToId": "m-201", "label": { "speech_act": ["answer"], "reusable": true, "answers_message_id": "m-201" } },
    { "id": "m-203", "sender": "ravi", "text": "The 118 stop is on the east side of Costco, near the pharmacy entrance.", "sentAt": "2026-09-02T09:29:00+08:00", "replyToId": "m-201", "label": { "speech_act": ["answer"], "reusable": true, "answers_message_id": "m-201" } },
    { "id": "m-204", "sender": "noah", "text": "Parking permit question: where do new students apply?", "sentAt": "2026-08-28T12:00:00+08:00", "label": { "speech_act": ["question"], "needs_counterpart": false } },
    { "id": "m-205", "sender": "leo", "text": "Use the Campus Mobility portal, choose “student resident,” upload your housing confirmation, then collect the permit from Building C. Fall applications open after Aug 20.", "sentAt": "2026-08-28T12:16:00+08:00", "replyToId": "m-204", "label": { "speech_act": ["answer"], "reusable": true, "answers_message_id": "m-204" } },
    { "id": "m-206", "sender": "mia", "text": "That solved it, thank you!", "sentAt": "2026-08-28T12:20:00+08:00", "replyToId": "m-205", "label": { "speech_act": ["acknowledgement"], "reusable": false, "updates": null } },
    { "id": "m-207", "sender": "zoe", "text": "Does anyone know where parking permits are applied for?", "sentAt": "2026-09-08T10:00:00+08:00", "label": { "speech_act": ["question"], "needs_counterpart": false } },
